# Direct Strike Online — an actively developed game: always revalidate so
# every git pull is visible immediately (files are tiny; ETags keep
# revalidation cheap). Also neutralizes Hostinger's aggressive edge cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
